# Absolute public origin of the deployed site, no trailing slash.
# When set, every page emits a <link rel="canonical"> and matching og:url.
# Leave unset for local development.
VITE_SITE_URL=

# POST endpoint for the contact form. Empty = the form shows a "not connected"
# notice and offers a prefilled mailto draft instead of pretending to send.
VITE_CONTACT_ENDPOINT=
